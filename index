// Cleans up the raw roster: trims stray whitespace that used to make "Jon
// Jones " and "Jon Jones" look like different fighters, assigns each entry a
// stable id (name+weight class+era, so it survives re-renders and sorting),
// and tags a career-stage from the display-name convention used above.
function deriveStage(name) {
  if (/\(Late\)/i.test(name)) return "late";
  if (/\(early\)/i.test(name)) return "early";
  return "prime";
}
function slugify(str) {
  return str.trim().toLowerCase().replace(/[()]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
const MASTER_FIGHTERS = MASTER_FIGHTERS_RAW.map((f) => {
  const cleanName = f.n.trim();
  return {
    ...f,
    n: cleanName,
    id: `${slugify(cleanName)}-${slugify(f.wc)}-${f.era}`,
    stage: deriveStage(cleanName),
  };
});

// How many fighters appear on the draft board each round. The underlying pool
// is much larger (20 per weight-class/era cell), so this keeps the board
// scannable while still giving different fighters across different runs --
// and, in seeded modes, the same five for everyone on the same board.
const BOARD_SIZE = 5;

function rosterFor(wc, era) {
  return MASTER_FIGHTERS.filter((f) => f.wc === wc && f.era === era);
}

// Draws BOARD_SIZE fighters from the cell's full pool. Pass the seeded rng in
// Daily/Challenge so every player sees the identical five.
function boardFor(wc, era, rng = Math.random) {
  const pool = rosterFor(wc, era);
  if (pool.length <= BOARD_SIZE) return pool;
  return shuffle(pool, rng).slice(0, BOARD_SIZE);
}

function pickCompatiblePair(excludeWc, rng = Math.random) {
  const options = excludeWc ? WEIGHT_CLASSES.filter((w) => w !== excludeWc) : WEIGHT_CLASSES;
  const wc = options[Math.floor(rng() * options.length)];
  const eras = erasForClass(wc);
  const era = eras[Math.floor(rng() * eras.length)];
  return { wc, era };
}

// C1 weight-class lock: after round 1 the division is fixed for the rest of
// the draft, but the ERA still rotates round to round. That keeps variety
// alive (and keeps the Era respin meaningful) while making the build a
// coherent fighter from one division rather than a cross-division chimera.
function pickEraWithinClass(wc, rng = Math.random) {
  const eras = erasForClass(wc);
  return { wc, era: eras[Math.floor(rng() * eras.length)] };
}

function shuffle(arr, rng = Math.random) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(rng() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function tierOf(r) {
  if (r >= 90) return { label: "LEGENDARY", cls: "tier-legend" };
  if (r >= 80) return { label: "GOLD", cls: "tier-gold" };
  if (r >= 70) return { label: "SILVER", cls: "tier-silver" };
  return { label: "BRONZE", cls: "tier-bronze" };
}
// Colorblind-safe: tier is conveyed by icon shape as well as color, never color alone.
function TierIcon({ cls, size = 12 }) {
  if (cls === "tier-legend") return <Crown size={size} />;
  if (cls === "tier-gold") return <Star size={size} />;
  if (cls === "tier-silver") return <Diamond size={size} />;
  return <Circle size={size} />;
}

// Retuned so a near-perfect build is rare: elite bonus only kicks in at 96+,
// weak-stat penalties are harsher, and the balance-bonus window is tighter.
// Same formula as before, just factored so the UI can show the real
// component breakdown (base/elite/balance/weak) instead of only the final
// number. computeGoatScore() below is unchanged in behavior.
function computeGoatScoreBreakdown(picks) {
  const values = ATTRS.map((a) => picks[a.key].scoreValue);
  const avg = values.reduce((s, r) => s + r, 0) / values.length;
  const base = Math.round(((avg - 50) / 49) * 100);
  const elite = values.filter((r) => r >= 96).length * 2 + values.filter((r) => r >= 90 && r < 96).length * 1;
  const weak = values.filter((r) => r < 55).length * 5 + values.filter((r) => r >= 55 && r < 65).length * 2;
  const spread = Math.max(...values) - Math.min(...values);
  const balance = spread <= 12 ? 5 : spread <= 22 ? 2 : 0;
  const final = Math.max(0, Math.min(100, base + elite + balance - weak));
  return { base, elite, balance, weak, spread, final };
}
function computeGoatScore(picks) {
  return computeGoatScoreBreakdown(picks).final;
}

