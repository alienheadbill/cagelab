  const overall = Math.round(SKILL_KEYS.reduce((s, k) => s + currentStats[k], 0) / SKILL_KEYS.length);
  let strongest = { key: SKILL_KEYS[0], val: -1 }, weakest = { key: SKILL_KEYS[0], val: 999 };
  SKILL_KEYS.forEach((k) => {
